{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow.dev/schemas/question.schema.json",
  "title": "Question",
  "description": "Morrow-Knowledge 题目数据标准",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "content",
    "question_type",
    "difficulty",
    "difficulty_basis",
    "answer",
    "explanation",
    "knowledge_tags",
    "source_type",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^math_higher_q_[0-9]{6}$"
    },
    "content": {
      "type": "string",
      "minLength": 8,
      "description": "题干；数学公式使用 LaTeX，行内用 $...$，独立公式用 $$...$$"
    },
    "question_type": {
      "type": "string",
      "enum": ["single_choice", "multiple_choice", "true_false", "fill_blank", "calculation", "proof"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["basic", "easier", "medium", "harder", "hard"]
    },
    "exam_level": {
      "type": "string",
      "enum": ["score_free", "basic", "advanced", "challenging"]
    },
    "options": {
      "type": "array",
      "description": "选择与判断题必填，填空与解答题不得填写",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "content"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-H]$" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "images": {
      "type": "array",
      "description": "题干、选项与解析中引用的图片。position 决定挂载点：stem 题干、explanation 解析、option:KEY 指定选项。",
      "items": { "$ref": "https://morrow.dev/schemas/content-image.schema.json" }
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "标准答案；选择题填选项 key，多选按字母升序拼接如 AC"
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "description": "解析必须能独立复现解题过程，并说明关键步骤为什么成立"
    },
    "knowledge_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "pattern": "^math_higher_[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "source_type": {
      "type": "string",
      "enum": ["real_exam", "adapted_exam", "ai_generated"]
    },
    "source_reference": {
      "type": "string",
      "description": "AI 原创写生成批次；真题与改编题由 source_exam_id 指向真题登记项"
    },
    "source_exam_id": {
      "type": "string",
      "pattern": "^math_higher_exam_[a-z0-9_]+$",
      "description": "真题或改编题必填，指向 exam-sources.yaml 中的登记项；无授权的真题只登记元数据，不入题库"
    },
    "adaptation_note": {
      "type": "string",
      "minLength": 10,
      "description": "改编题必填：说明相对原题改了什么，以及为什么这样改"
    },
    "difficulty_basis": {
      "type": "string",
      "minLength": 6,
      "description": "难度判定依据，写目标人群的正确率区间，而不是主观感受"
    },
    "solution_methods": {
      "type": "array",
      "items": { "type": "string", "minLength": 6 },
      "description": "可行的解法名称与要点，用于教学时切换讲法"
    },
    "common_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error_type", "description"],
        "properties": {
          "error_type": {
            "type": "string",
            "enum": [
              "concept",
              "formula_theorem",
              "calculation",
              "logic",
              "method_choice",
              "reading",
              "transfer",
              "expression"
            ]
          },
          "description": { "type": "string", "minLength": 6 }
        }
      }
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "question_type": { "enum": ["single_choice", "multiple_choice", "true_false"] }
        },
        "required": ["question_type"]
      },
      "then": {
        "required": ["options"],
        "properties": { "options": { "minItems": 2 } }
      }
    },
    {
      "if": {
        "properties": {
          "question_type": { "enum": ["fill_blank", "calculation", "proof"] }
        },
        "required": ["question_type"]
      },
      "then": {
        "not": { "required": ["options"] }
      }
    },
    {
      "if": {
        "properties": { "question_type": { "const": "true_false" } },
        "required": ["question_type"]
      },
      "then": {
        "required": ["options"],
        "properties": { "options": { "minItems": 2, "maxItems": 2 } }
      }
    },
    {
      "if": {
        "properties": { "source_type": { "enum": ["real_exam", "adapted_exam"] } },
        "required": ["source_type"]
      },
      "then": {
        "required": ["source_exam_id"]
      }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "adapted_exam" } },
        "required": ["source_type"]
      },
      "then": {
        "required": ["adaptation_note"]
      }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "ai_generated" } },
        "required": ["source_type"]
      },
      "then": {
        "not": { "required": ["source_exam_id"] }
      }
    }
  ]
}
