{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow.dev/schemas/knowledge-point.schema.json",
  "title": "KnowledgePoint",
  "description": "Morrow-Knowledge 知识点数据标准",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "subject_id",
    "chapter_id",
    "description",
    "difficulty",
    "exam_importance",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^math_higher_[a-z0-9_]+$",
      "description": "稳定唯一 ID，创建后不得因名称调整而变化"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "subject_id": {
      "type": "string",
      "pattern": "^math_higher$"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^math_higher_[a-z0-9_]+$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "知识点的定义或说明，必须能独立读懂"
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 4 }
    },
    "prerequisites": {
      "type": "array",
      "description": "课程体系中的正式前置关系，不得填写 AI 本次推断的原因",
      "items": { "type": "string", "pattern": "^math_higher_[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "related_points": {
      "type": "array",
      "items": { "type": "string", "pattern": "^math_higher_[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "difficulty": {
      "type": "string",
      "enum": ["basic", "easier", "medium", "harder", "hard"]
    },
    "exam_importance": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "exam_levels": {
      "type": "array",
      "description": "该知识点在考试中通常出现的训练层次，与 difficulty 分开维护",
      "items": {
        "type": "string",
        "enum": ["score_free", "basic", "advanced", "challenging"]
      },
      "uniqueItems": true
    },
    "common_errors": {
      "type": "array",
      "items": { "type": "string", "minLength": 6 },
      "description": "该知识点的高频错误描述，用于诊断归因，不得写成具体题目答案"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["textbook", "exam_syllabus", "exam_paper", "official_doc", "other"]
          },
          "reference": { "type": "string", "minLength": 3 },
          "license": {
            "type": "string",
            "description": "版权或授权状态；不明确时填写 unclear"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
