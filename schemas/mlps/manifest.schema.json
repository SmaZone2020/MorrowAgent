{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow.dev/schemas/mlps/manifest.schema.json",
  "title": "LearningPackageManifest",
  "description": "MLPS manifest.yaml。学习包的唯一入口：客户端只读它来发现内容，而不是遍历目录。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "package", "author", "compatibility", "contents", "integrity"],
  "properties": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "morrow-learning-package" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "subject", "language"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$",
          "description": "反向域名式全局唯一 ID，创建后不得修改。"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "description": { "type": "string", "maxLength": 400 },
        "subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "sub_subject": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
        "targets": {
          "type": "array",
          "description": "面向的考试或课程方向，自由标签但必须来自 taxonomy/tags.yaml。",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "region": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "description": "书架上用于筛选与说明的标签 ID，必须同时登记在 taxonomy/tags.yaml。标签名可以改，ID 不得改。",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "cover": { "$ref": "https://morrow.dev/schemas/mlps/cover.schema.json" }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_app_version"],
      "properties": {
        "min_app_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "questions", "relations", "taxonomy", "citations"],
      "properties": {
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": { "index": { "$ref": "#/$defs/packagePath" } }
        },
        "questions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": { "index": { "$ref": "#/$defs/packagePath" } }
        },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index"],
          "properties": { "index": { "$ref": "#/$defs/packagePath" } }
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tags", "error_types"],
          "properties": {
            "tags": { "$ref": "#/$defs/packagePath" },
            "error_types": { "$ref": "#/$defs/packagePath" }
          }
        },
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources"],
          "properties": { "sources": { "$ref": "#/$defs/packagePath" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "显式声明的依赖，不得在运行时静默下载。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "optional": { "type": "boolean", "default": false }
        }
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "file"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "file": { "const": "checksums.sha256" }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "description": "包内相对 POSIX 路径。禁止绝对路径、反斜杠、.. 与盘符，避免路径穿越。",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    }
  }
}
