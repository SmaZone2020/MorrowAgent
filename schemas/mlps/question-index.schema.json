{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morrow.dev/schemas/mlps/question-index.schema.json",
  "title": "QuestionIndex",
  "description": "questions/index.yaml。题目文件分组，避免单文件过大，也让客户端按需读取。",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "count"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^questions/(original|adapted|imported|generated)/[A-Za-z0-9._-]+\\.json$"
          },
          "chapter": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$" },
          "count": { "type": "integer", "minimum": 0 },
          "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
        }
      }
    }
  }
}
