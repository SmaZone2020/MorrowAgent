{
  "schema_version": "1.0",
  "solutions": [
    {
      "question_id": "calculus.limit.q.000001",
      "schema_version": "1.0",
      "explanation": {
        "summary": "分段函数在分界点求极限，必须分别看左右极限；两侧不相等，极限就不存在。",
        "steps": [
          { "index": 1, "content": "左极限：$x \\to 0^-$ 时走 $x<0$ 这支，$\\lim\\limits_{x \\to 0^-}(x+1)=1$。" },
          { "index": 2, "content": "右极限：$x \\to 0^+$ 时走 $x \\ge 0$ 这支，$\\lim\\limits_{x \\to 0^+}x^2=0$。" },
          { "index": 3, "content": "左右极限不等，所以 $\\lim\\limits_{x \\to 0}f(x)$ 不存在。" }
        ],
        "final_answer": "C"
      },
      "common_errors": [
        "只代入右支的 $x^2$ 得到 $0$，忽略了左支的极限是 $1$。",
        "把 $f(0)=0$ 当成极限值：函数在一点取值与极限无关。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000002",
      "schema_version": "1.0",
      "explanation": {
        "summary": "极限存在要求左右极限相等，据此列方程解 $a$。",
        "steps": [
          { "index": 1, "content": "左极限：$\\lim\\limits_{x \\to 1^-}(2x+a)=2+a$。" },
          { "index": 2, "content": "右极限：$\\lim\\limits_{x \\to 1^+}x^2=1$。" },
          { "index": 3, "content": "极限存在即左右相等：$2+a=1$，得 $a=-1$。" }
        ],
        "final_answer": "$-1$"
      },
      "common_errors": [
        "把 $x=1$ 直接代入 $2x+a$，得到 $2+a$ 后忘记再与右侧比较。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000003",
      "schema_version": "1.0",
      "explanation": {
        "summary": "连续要求极限值等于函数值，而 $x\\sin\\frac{1}{x}$ 是无穷小乘有界量。",
        "steps": [
          { "index": 1, "content": "$|\\sin\\frac{1}{x}| \\le 1$，所以 $|x\\sin\\frac{1}{x}| \\le |x| \\to 0$。" },
          { "index": 2, "content": "由夹逼定理，$\\lim\\limits_{x \\to 0}x\\sin\\frac{1}{x}=0$。" },
          { "index": 3, "content": "连续要求 $f(0)=\\lim\\limits_{x \\to 0}f(x)=0$，即 $a=0$。" }
        ],
        "final_answer": "A"
      },
      "common_errors": [
        "认为 $\\sin\\frac{1}{x}$ 在 $0$ 处无极限，就断定整个乘积无极限。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000004",
      "schema_version": "1.0",
      "explanation": {
        "summary": "定义域要同时满足对数真数为正、分母不为零。",
        "steps": [
          { "index": 1, "content": "对数要求 $x-1>0$，即 $x>1$。" },
          { "index": 2, "content": "分母要求 $x-5 \\ne 0$，即 $x \\ne 5$。" },
          { "index": 3, "content": "两者取交集：$(1,5)\\cup(5,+\\infty)$。" }
        ],
        "final_answer": "$(1,5)\\cup(5,+\\infty)$"
      },
      "common_errors": [
        "把 $x-1>0$ 写成 $x \\ge 1$，多算了 $x=1$。",
        "漏掉分母限制，写成 $(1,+\\infty)$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000005",
      "schema_version": "1.0",
      "explanation": {
        "summary": "$|x|$ 在 $0$ 两侧表达式不同，左右极限一正一负。",
        "steps": [
          { "index": 1, "content": "$x>0$ 时 $\\frac{|x|}{x}=1$，故右极限为 $1$。" },
          { "index": 2, "content": "$x<0$ 时 $\\frac{|x|}{x}=-1$，故左极限为 $-1$。" },
          { "index": 3, "content": "左右极限不等，极限不存在。" }
        ],
        "final_answer": "C"
      },
      "common_errors": [
        "把 $|x|$ 直接当成 $x$ 约掉，得到 $1$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000006",
      "schema_version": "1.0",
      "explanation": {
        "summary": "连续给出一个方程，$f(2)=3$ 再给出一个，联立即可。",
        "steps": [
          { "index": 1, "content": "在 $x=1$ 处连续：左极限 $1^2=1$，右极限 $a+b$，所以 $a+b=1$。" },
          { "index": 2, "content": "$x=2$ 落在 $x \\ge 1$ 一支，$f(2)=2a+b=3$。" },
          { "index": 3, "content": "两式相减得 $a=2$，代回得 $b=-1$。" }
        ],
        "final_answer": "$a=2$，$b=-1$"
      },
      "common_errors": [
        "只用一个条件就下结论，忽略了两个未知数需要两个方程。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000007",
      "schema_version": "1.0",
      "explanation": {
        "summary": "有理函数在 $x \\to \\infty$ 时只看最高次项。",
        "steps": [
          { "index": 1, "content": "分子分母同除以 $x^2$：$\\frac{3-\\frac{1}{x}+\\frac{2}{x^2}}{2+\\frac{1}{x^2}}$。" },
          { "index": 2, "content": "各项 $\\frac{1}{x},\\frac{1}{x^2} \\to 0$。" },
          { "index": 3, "content": "极限为 $\\frac{3}{2}$。" }
        ],
        "final_answer": "$\\frac{3}{2}$"
      },
      "common_errors": [
        "分子分母次数相同时误答 $0$ 或 $\\infty$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000008",
      "schema_version": "1.0",
      "explanation": {
        "summary": "用等价无穷小 $(1+x)^{\\alpha}-1 \\sim \\alpha x$。",
        "steps": [
          { "index": 1, "content": "$\\sqrt[3]{1+x}-1=(1+x)^{\\frac{1}{3}}-1 \\sim \\frac{1}{3}x$。" },
          { "index": 2, "content": "原式 $\\sim \\frac{\\frac{1}{3}x}{x}=\\frac{1}{3}$。" }
        ],
        "final_answer": "$\\frac{1}{3}$"
      },
      "common_errors": [
        "把 $\\sqrt[3]{1+x}-1$ 直接写成 $x$，漏掉系数 $\\frac{1}{3}$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000009",
      "schema_version": "1.0",
      "explanation": {
        "summary": "凑第二个重要极限 $(1+u)^{\\frac{1}{u}} \\to e$。",
        "steps": [
          { "index": 1, "content": "$(1+3x)^{\\frac{1}{x}}=\\left[(1+3x)^{\\frac{1}{3x}}\\right]^{3}$。" },
          { "index": 2, "content": "$x \\to 0$ 时 $3x \\to 0$，方括号内趋于 $e$。" },
          { "index": 3, "content": "所以原式为 $e^3$。" }
        ],
        "final_answer": "$e^3$"
      },
      "common_errors": [
        "忘记外层指数 $3$，答成 $e$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000010",
      "schema_version": "1.0",
      "explanation": {
        "summary": "用 $1-\\cos 2x=2\\sin^2 x$ 化简。",
        "steps": [
          { "index": 1, "content": "$1-\\cos 2x=2\\sin^2 x$。" },
          { "index": 2, "content": "原式 $=\\frac{2\\sin^2 x}{x\\sin x}=\\frac{2\\sin x}{x}$。" },
          { "index": 3, "content": "$\\frac{\\sin x}{x} \\to 1$，故极限为 $2$。" }
        ],
        "final_answer": "B"
      },
      "common_errors": [
        "用 $1-\\cos 2x \\sim 2x^2$ 时把分母的 $\\sin x$ 当成 $x$ 后忘记系数 $2$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000011",
      "schema_version": "1.0",
      "explanation": {
        "summary": "代入后是 $\\frac{0}{0}$，因式分解约去公因子。",
        "steps": [
          { "index": 1, "content": "$x^2-4=(x-2)(x+2)$。" },
          { "index": 2, "content": "$x^2-3x+2=(x-2)(x-1)$。" },
          { "index": 3, "content": "约去 $x-2$ 后为 $\\frac{x+2}{x-1}$，代入 $x=2$ 得 $4$。" }
        ],
        "final_answer": "$4$"
      },
      "common_errors": [
        "分母分解成 $(x-1)(x-2)$ 后误约成 $(x-1)(x+2)$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000012",
      "schema_version": "1.0",
      "explanation": {
        "summary": "左右极限相等但与函数值不同，属于可去间断点。",
        "steps": [
          { "index": 1, "content": "左极限 $\\lim\\limits_{x \\to 0^-}(x+1)=1$。" },
          { "index": 2, "content": "右极限 $\\lim\\limits_{x \\to 0^+}(x^2+1)=1$。" },
          { "index": 3, "content": "极限存在且等于 $1$，但 $f(0)=3 \\ne 1$，所以不连续。" }
        ],
        "final_answer": "B"
      },
      "common_errors": [
        "看到左右极限相等就判为连续，忘记比较 $f(0)$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000013",
      "schema_version": "1.0",
      "explanation": {
        "summary": "先用等差数列求和公式化简，再取极限。",
        "steps": [
          { "index": 1, "content": "$1+2+\\cdots+n=\\frac{n(n+1)}{2}$。" },
          { "index": 2, "content": "原式 $=\\frac{n(n+1)}{2n^2}=\\frac{n+1}{2n}$。" },
          { "index": 3, "content": "$n \\to \\infty$ 时趋于 $\\frac{1}{2}$。" }
        ],
        "final_answer": "$\\frac{1}{2}$"
      },
      "common_errors": [
        "把求和当成 $n$ 项常数相加，得到 $\\frac{1}{n}\\to 0$。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000014",
      "schema_version": "1.0",
      "explanation": {
        "summary": "左右极限都存在还不够，必须相等。",
        "steps": [
          { "index": 1, "content": "极限存在的充要条件是左右极限都存在且相等。" },
          { "index": 2, "content": "题目只给出「都存在」，没有给出相等。" },
          { "index": 3, "content": "例如 $f(x)=\\frac{|x|}{x}$ 在 $0$ 处左右极限为 $-1$ 与 $1$，极限不存在，所以命题错误。" }
        ],
        "final_answer": "B"
      },
      "common_errors": [
        "把「左右极限存在」误当成「极限存在」。"
      ]
    },
    {
      "question_id": "calculus.limit.q.000015",
      "schema_version": "1.0",
      "explanation": {
        "summary": "各项分母介于 $\\sqrt{n^2+1}$ 与 $\\sqrt{n^2+n}$ 之间，用夹逼定理。",
        "steps": [
          { "index": 1, "content": "共有 $n$ 项，每项都不小于 $\\frac{1}{\\sqrt{n^2+n}}$、不大于 $\\frac{1}{\\sqrt{n^2+1}}$。" },
          { "index": 2, "content": "所以 $\\frac{n}{\\sqrt{n^2+n}} \\le S_n \\le \\frac{n}{\\sqrt{n^2+1}}$。" },
          { "index": 3, "content": "两端都趋于 $1$（分子分母同除以 $n$），故 $S_n \\to 1$。" }
        ],
        "final_answer": "$1$"
      },
      "common_errors": [
        "把 $n$ 项直接当成 $n \\cdot \\frac{1}{n}=1$ 而不说明理由，缺少夹逼论证。"
      ]
    }
  ]
}
